HOSTED_IMAGE=dsh-hosted-workspaces:local
HOSTED_PUBLIC_ORIGIN=http://chat.localhost:8080
HOSTED_PORT=8080
HOSTED_PREFIX=dsh-workspace
# Optional compose.resources.yml: absolute published collection path on the Docker daemon host.
HOSTED_SHARED_RESOURCES_PATH=
HOSTED_ALLOW_HTTP=true
HOSTED_OIDC_ISSUER=https://sso.example.com
HOSTED_OIDC_CLIENT_ID=dsh-workspaces
HOSTED_OIDC_FLOW=authorization-code
HOSTED_OIDC_DISCOVERY_URL=
HOSTED_OIDC_CLIENT_SECRET_PATH=./secrets/oidc_client_secret
HOSTED_DEEPSEEK_KEY_PATH=./secrets/deepseek_api_key
# Optional company Responses model. Base URL includes its API prefix, e.g. https://models.example.com/v1.
HOSTED_MODEL_PROTOCOL=anthropic-messages
HOSTED_MODEL_BASE_URL=
HOSTED_MODEL_KEY_FILE=/run/secrets/deepseek_api_key
HOSTED_MODEL_ID=deepseek-flash
HOSTED_MODEL_CONTEXT_WINDOW=32768
HOSTED_MODEL_MAX_TOKENS=8192
# Optional compose.clinical.yml; database credentials stay in the gateway secret mount.
EMR_READER_SOURCE_SYSTEM=emr-development
EMR_READER_DATABASE_CONFIG_PATH=./secrets/emr_database.json
EMR_READER_ALLOWLIST_PATH=./secrets/emr_allowlist.json
EMR_READER_BINDING_KEY_PATH=./secrets/emr_binding_key

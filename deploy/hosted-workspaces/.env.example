HOSTED_IMAGE=dsh-hosted-workspaces:local
HOSTED_PUBLIC_ORIGIN=http://chat.localhost:8080
HOSTED_PORT=8080
HOSTED_PREFIX=dsh-workspace
HOSTED_ALLOW_HTTP=true
HOSTED_OIDC_ISSUER=https://sso.example.com
HOSTED_OIDC_CLIENT_ID=dsh-workspaces
HOSTED_OIDC_FLOW=authorization-code
HOSTED_OIDC_DISCOVERY_URL=
HOSTED_OIDC_CLIENT_SECRET_PATH=./secrets/oidc_client_secret
HOSTED_DEEPSEEK_KEY_PATH=./secrets/deepseek_api_key
